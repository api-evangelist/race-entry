{
  "opencollection": "1.0.0",
  "info": {
    "name": "Race Entry Software Event Login API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "tmp_key",
      "value": "{{tmp_key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Login",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Login",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.raceentry.com/softwareapi/login"
          },
          "docs": "Authenticate and receive a temporary key and secret valid for 48 hours."
        }
      ]
    }
  ],
  "bundled": true
}