{
  "opencollection": "1.0.0",
  "info": {
    "name": "Race Entry Software Event Memberships API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "tmp_key",
      "value": "{{tmp_key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Memberships",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get clubs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.raceentry.com/softwareapi/memberships/get-clubs"
          },
          "docs": "List clubs for membership management."
        },
        {
          "info": {
            "name": "Get club members",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.raceentry.com/softwareapi/memberships/get-members"
          },
          "docs": "List members for a given club."
        }
      ]
    }
  ],
  "bundled": true
}